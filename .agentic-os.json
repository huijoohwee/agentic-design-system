{
  "schema": "agentic-os/repository-profile/v1",
  "repository": "github.com/huijoohwee/agentic-design-system",
  "canonical": {
    "localRef": "refs/heads/main",
    "remoteRef": "refs/remotes/origin/main"
  },
  "adapters": {
    "repository": {
      "id": "git",
      "version": "1"
    },
    "provider": {
      "id": "github",
      "version": "1"
    }
  },
  "requiredChecks": [
    "Integration Gate"
  ],
  "capabilities": [
    "protected-integration:pull-request",
    "remove-clean-worktree-cleanup-opt-in"
  ],
  "authority": {
    "runtime": "consumer",
    "release": "consumer"
  },
  "cleanup": {
    "localBranch": "retain",
    "remoteBranch": "retain",
    "remoteTrackingRef": "retain",
    "unreachableObjects": "retain",
    "worktreeProjection": "remove-clean",
    "worktreeRegistration": "remove-clean"
  },
  "profileDigest": "b738aa4a5310260cb0d36ac888352bf7449d62468d1148e992d3610a3d0a2b3f"
