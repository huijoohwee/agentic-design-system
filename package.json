{
  "name": "agentic-design-system",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "exports": {
    "./floating-panel": "./site/floating-panel.js",
    "./inline-editor": {
      "types": "./site/inline-editor.d.ts",
      "import": "./site/inline-editor.js"
    },
    "./react/panels": {
      "types": "./packages/react-panels/src/index.ts",
      "import": "./packages/react-panels/src/index.ts"
    },
    "./ktv": {
      "types": "./site/key-type-value.d.ts",
      "import": "./site/key-type-value.js"
    },
    "./react/ktv": {
      "types": "./packages/react-ktv/src/index.tsx",
      "import": "./packages/react-ktv/src/index.tsx"
    },
    "./hover": {
      "types": "./site/hover.d.ts",
      "import": "./site/hover.js"
    },
    "./hover/text": {
      "types": "./site/hover-text.d.ts",
      "import": "./site/hover-text.js"
    },
    "./hover.css": "./site/hover.css",
    "./react/hover": {
      "types": "./packages/react-hover/src/index.tsx",
      "import": "./packages/react-hover/src/index.tsx"
    },
    "./sections": {
      "types": "./site/panel-section.d.ts",
      "import": "./site/panel-section.js"
    },
    "./sections.css": "./site/panel-section.css",
    "./markdown": {
      "types": "./site/markdown.d.ts",
      "import": "./site/markdown.js"
    },
    "./markdown/parser": {
      "types": "./site/markdown-parser.d.ts",
      "import": "./site/markdown-parser.js"
    },
    "./color": {
      "types": "./site/color.d.ts",
      "import": "./site/color.js"
    },
    "./react/rich-text": {
      "types": "./packages/react-rich-text/src/index.tsx",
      "import": "./packages/react-rich-text/src/index.tsx"
    },
    "./rich-text.css": "./site/rich-text.css",
    "./viewer": {
      "types": "./site/viewer-surface.d.ts",
      "import": "./site/viewer-surface.js"
    },
    "./react/viewer": {
      "types": "./packages/react-viewer/src/index.tsx",
      "import": "./packages/react-viewer/src/index.tsx"
    },
    "./viewer.css": "./site/viewer-surface.css",
    "./collection-layout": {
      "types": "./site/collection-layout.d.ts",
      "import": "./site/collection-layout.js"
    },
    "./collection-layout.css": "./site/collection-layout.css",
    "./skills-commands": {
      "types": "./site/skills-commands.d.ts",
      "import": "./site/skills-commands.js"
    },
    "./skills-commands.css": "./site/skills-commands.css"
  },
  "engines": {
    "node": ">=20.11"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "doctor": "agentic-os doctor",
    "lane": "agentic-os start",
    "land": "agentic-os land",
    "dev": "node scripts/dev.mjs",
    "check:design-system": "node --test scripts/panel-controls.test.mjs scripts/react-panel-adapter.test.mjs scripts/key-type-value.test.mjs scripts/hover.test.mjs scripts/panel-section.test.mjs scripts/markdown.test.mjs scripts/viewer-surface.test.mjs && node scripts/design-registry.mjs check",
    "mcp": "node scripts/design-registry.mjs mcp"
  },
  "devDependencies": {
    "agentic-os": "https://codeload.github.com/huijoohwee/agentic-os/tar.gz/89acc7ad671e9cef77b8216ba127a08efa3ac211"
  }
}
